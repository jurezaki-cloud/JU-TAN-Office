/* JU-TAN Office Enterprise — global stylesheet (tokenized) */

QMainWindow,
QDialog,
QStackedWidget,
QSplitter,
QAbstractScrollArea {
    background: {{BACKGROUND}};
}

/* Globalno ozadje prepreči bele lisice na nestiliranih panelih. */
QWidget {
    background-color: {{BACKGROUND}};
    background: {{BACKGROUND}};
    color: {{TEXT}};
    font-family: "Segoe UI";
    font-size: 13px;
}

QLabel {
    background: transparent;
    color: {{TEXT}};
}

QLabel#PageTitle {
    font-size: 18px;
    font-weight: 700;
    padding: 2px 0;
}

QLabel#PageTitleLarge {
    font-size: 20px;
    font-weight: 700;
}

QLabel#SectionTitle {
    font-size: 14px;
    font-weight: 700;
    padding-bottom: 6px;
}

QLabel#PageHeaderTitle {
    font-size: 18px;
    font-weight: 700;
    color: {{TEXT}};
}

QLabel#PageHeaderDescription {
    font-size: 12px;
    color: {{TEXT_MUTED}};
}

QLabel#ToolbarTitle {
    font-size: 22px;
    font-weight: 700;
}

#AppWorkspace {
    background: {{BACKGROUND}};
}

#ModernToolbar {
    background: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{CARD_RADIUS}};
}

#ModernToolbar QWidget {
    background: transparent;
}

#ToolbarModuleTitle {
    font-size: 15px;
    font-weight: 700;
    color: {{TEXT}};
    letter-spacing: 0.1px;
}

#ToolbarModuleSubtitle {
    font-size: 11px;
    color: {{TEXT_MUTED}};
}

#ToolbarSearch {
    min-height: 36px;
    max-height: 36px;
    background: {{BACKGROUND}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 6px 12px;
}

#ToolbarSearch:focus {
    background: {{SURFACE}};
    border: 1px solid {{PRIMARY}};
}

#ModernToolbar QPushButton#PrimaryButton,
#ModernToolbar QPushButton#SecondaryButton,
#ModernToolbar QPushButton#ToolbarIconButton {
    min-height: 34px;
    max-height: 34px;
    padding: 4px 14px;
    border-radius: 8px;
}

#ModernToolbar QPushButton#PrimaryButton {
    padding-left: 12px;
    padding-right: 12px;
    font-weight: 700;
}

#ModernToolbar QPushButton#ToolbarIconButton {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    font-weight: 500;
    min-width: 34px;
    max-width: 34px;
    padding: 0;
}

#ModernToolbar QPushButton#ToolbarIconButton:hover {
    background: {{TABLE_HEADER}};
    border-color: {{PRIMARY}};
}

#ModernToolbar QPushButton#ToolbarIconButton:pressed {
    background: {{HOVER}};
}

QToolButton#ToolbarUserButton {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 4px 10px;
    font-weight: 600;
    min-height: 34px;
    max-height: 34px;
}

QToolButton#ToolbarUserButton:hover,
QToolButton#ToolbarUserButton:pressed {
    background: {{TABLE_HEADER}};
}

QLabel#TotalValue {
    font-size: 22px;
    font-weight: 800;
    color: {{PRIMARY}};
    letter-spacing: 0.3px;
    padding: 4px 8px;
}

QPushButton {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: {{CONTROL_RADIUS}};
    padding: 6px 14px;
    font-weight: 600;
    font-size: 13px;
    min-height: 34px;
}

QPushButton:hover {
    background: {{TABLE_HEADER}};
}

QPushButton:pressed {
    background: {{HOVER}};
}

QPushButton:disabled {
    background: {{TABLE_HEADER}};
    color: {{DISABLED}};
    border-color: {{BORDER}};
}

QPushButton:focus {
    border: 1px solid {{FOCUS}};
}

/* Pripravljene variante — aktivne šele z objectName; obstoječi gumbi ostanejo privzeti QPushButton. */
QPushButton#PrimaryButton {
    background: {{PRIMARY}};
    color: {{ON_PRIMARY}};
    border: 1px solid {{PRIMARY}};
}

QPushButton#PrimaryButton:hover,
QPushButton#PrimaryButton:pressed {
    background: {{PRIMARY_HOVER}};
    border-color: {{PRIMARY_HOVER}};
}

QPushButton#PrimaryButton:disabled {
    background: {{BORDER}};
    color: {{SECONDARY}};
    border-color: {{BORDER}};
}

QPushButton#SecondaryButton {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
}

QPushButton#SecondaryButton:hover,
QPushButton#SecondaryButton:pressed {
    background: {{TABLE_HEADER}};
}

QPushButton#GhostButton {
    background: transparent;
    color: {{TEXT}};
    border: 1px solid transparent;
}

QPushButton#GhostButton:hover {
    background: {{HOVER}};
}

QPushButton#DangerButton {
    background: transparent;
    color: {{DANGER}};
    border: 1px solid {{BORDER}};
}

QPushButton#DangerButton:hover,
QPushButton#DangerButton:pressed {
    background: {{DANGER}};
    color: {{ON_PRIMARY}};
    border-color: {{DANGER}};
}

QPushButton#IconButton {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QPushButton#IconButton:hover {
    background: {{TABLE_HEADER}};
    border-color: {{PRIMARY}};
}

QPushButton#SuccessButton {
    background: {{SUCCESS}};
    color: {{ON_PRIMARY}};
    border: none;
}

QPushButton#SuccessButton:hover,
QPushButton#SuccessButton:pressed {
    background: {{SUCCESS_HOVER}};
}

QPushButton#WarningButton {
    background: {{WARNING}};
    color: {{TEXT}};
    border: none;
}

QPushButton#WarningButton:hover,
QPushButton#WarningButton:pressed {
    background: {{WARNING_HOVER}};
}

QLineEdit,
QComboBox,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: {{CONTROL_RADIUS}};
    padding: 6px 10px;
    selection-background-color: {{PRIMARY}};
    selection-color: {{ON_PRIMARY}};
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{HOVER}};
    selection-color: {{TEXT}};
    outline: none;
    padding: 4px;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 1px solid {{PRIMARY}};
}

QTableView,
QTableWidget {
    background: {{SURFACE}};
    alternate-background-color: {{TABLE_ALTERNATE}};
    gridline-color: transparent;
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    selection-background-color: {{SELECTED}};
    selection-color: {{TEXT}};
    outline: none;
}

QTableView::item,
QTableWidget::item {
    padding: 8px 10px;
    border: none;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background: {{HOVER}};
}

QTableView::item:selected,
QTableWidget::item:selected {
    background: {{SELECTED}};
    color: {{TEXT}};
}

QHeaderView::section {
    background: {{TABLE_HEADER}};
    color: {{TEXT_MUTED}};
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid {{BORDER}};
    font-weight: 600;
    font-size: 11px;
    text-transform: none;
}

QTableCornerButton::section {
    background: {{TABLE_HEADER}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QGroupBox {
    background: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QDialog {
    background: {{BACKGROUND}};
}

QFrame#StatCard,
QFrame#KpiCard,
QFrame#DashboardCard {
    background: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{CARD_RADIUS}};
}

QFrame#KpiCard:hover,
QFrame#DashboardCard:hover {
    border: 1px solid {{BORDER}};
    background: {{SURFACE_ELEVATED}};
}

QLabel#StatTitle,
QLabel#KpiTitle {
    font-size: 12px;
    font-weight: 600;
    color: {{TEXT_MUTED}};
}

QLabel#StatValue,
QLabel#KpiValue {
    font-size: 26px;
    font-weight: 700;
    color: {{TEXT}};
    letter-spacing: -0.3px;
}

QLabel#KpiHint,
QLabel#DashboardMuted {
    font-size: 11px;
    color: {{TEXT_MUTED}};
}

QLabel#DashboardWelcome {
    font-size: 18px;
    font-weight: 700;
    color: {{TEXT}};
}

QLabel#DashboardDate {
    font-size: 12px;
    color: {{TEXT_MUTED}};
}

QLabel#DashboardSectionTitle {
    font-size: 13px;
    font-weight: 700;
    color: {{TEXT}};
}

#DashboardScroll,
#DashboardCanvas,
#AnalyticsScroll,
#AnalyticsCanvas {
    background: {{BACKGROUND}};
    border: none;
}

#DashboardTable {
    background: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: {{SELECTED}};
    selection-color: {{TEXT}};
}

#DashboardTable::item {
    padding: 8px 10px;
}

#DashboardTable QHeaderView::section {
    background: {{TABLE_HEADER}};
    color: {{TEXT_MUTED}};
    font-size: 11px;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

#DashboardActivity {
    background: transparent;
    border: none;
    color: {{TEXT}};
    outline: none;
}

#DashboardActivity::item {
    padding: 10px 6px;
    border-bottom: 1px solid {{BORDER}};
    color: {{TEXT}};
}

#DashboardActivity::item:hover {
    background: {{HOVER}};
}

#PageToolbar {
    background: transparent;
}

QStatusBar {
    background: {{SURFACE}};
    color: {{SECONDARY}};
    border-top: 1px solid {{BORDER}};
    min-height: 28px;
    padding: 4px 16px;
    font-size: 12px;
}

QMenu {
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px 8px 12px;
    border-radius: 6px;
    min-height: 28px;
}

QMenu::item:selected {
    background: {{HOVER}};
    color: {{TEXT}};
}

QMenu::item:disabled {
    color: {{DISABLED}};
}

QMenu::separator {
    height: 1px;
    background: {{BORDER}};
    margin: 4px 8px;
}

QMenu#NewMenu {
    min-width: 200px;
}

QSplitter::handle {
    background: {{BORDER}};
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: {{BORDER}};
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: {{TEXT_MUTED}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: {{BORDER}};
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: {{TEXT_MUTED}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
    border: none;
}

QToolTip {
    background: {{SURFACE_ELEVATED}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    padding: 6px 10px;
    border-radius: 6px;
}

/* Sidebar — Enterprise navigation (barve iz app/theme/colors.py) */
#Sidebar,
#SidebarHeader,
#SidebarFooter,
#Sidebar QWidget {
    background: {{SIDEBAR_BG}};
}

#SidebarNavScroll {
    background: {{SIDEBAR_BG}};
    border: none;
}

#SidebarNavScroll QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

#SidebarNavScroll QScrollBar::handle:vertical {
    background: {{SIDEBAR_PRESSED}};
    border-radius: 4px;
    min-height: 32px;
}

#SidebarNavScroll QScrollBar::handle:vertical:hover {
    background: {{SIDEBAR_MUTED}};
}

#Sidebar QLabel {
    background: transparent;
}

#SidebarHeader {
    background: {{SIDEBAR_BG}};
}

#Sidebar #SidebarBrand,
#SidebarBrand {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: {{SIDEBAR_TEXT}};
}

#Sidebar #SidebarLogo,
#SidebarLogo {
    background: transparent;
    padding: 2px 2px;
}

#Sidebar #SidebarSubtitle,
#SidebarSubtitle {
    font-size: 11px;
    color: {{SIDEBAR_MUTED}};
}

#SidebarHeaderLine {
    background: {{SIDEBAR_PRESSED}};
    border: none;
    max-height: 1px;
}

#SidebarFooter {
    background: {{SIDEBAR_BG}};
    border-top: 1px solid {{SIDEBAR_PRESSED}};
}

#Sidebar #SidebarFooterTitle,
#SidebarFooterTitle {
    font-size: 11px;
    font-weight: 500;
    color: {{SIDEBAR_MUTED}};
}

#Sidebar #SidebarFooterVersion,
#SidebarFooterVersion,
#Sidebar #SidebarFooterUser,
#SidebarFooterUser {
    font-size: 11px;
    font-weight: 400;
    color: {{SIDEBAR_MUTED}};
}

#SidebarCollapseButton {
    background: transparent;
    border: 1px solid {{SIDEBAR_PRESSED}};
    border-radius: 6px;
    padding: 0;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
}

#SidebarCollapseButton:hover {
    background: {{SIDEBAR_HOVER}};
    border-color: {{SIDEBAR_MUTED}};
}

#NavSectionLabel {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: {{SIDEBAR_MUTED}};
    padding: 8px 10px 2px 10px;
    background: transparent;
    max-height: 24px;
}

NavigationButton,
#Sidebar NavigationButton {
    background: transparent;
    color: {{SIDEBAR_TEXT}};
    border: none;
    border-left: 3px solid transparent;
    border-radius: 8px;
    text-align: left;
    padding: 0 8px 0 10px;
    font-size: 13px;
    font-weight: 500;
    min-height: 36px;
    max-height: 36px;
}

NavigationButton:hover,
#Sidebar NavigationButton:hover {
    background: {{SIDEBAR_HOVER}};
}

NavigationButton:hover:checked,
#Sidebar NavigationButton:hover:checked {
    background: {{SIDEBAR_ACTIVE}};
}

#Sidebar[collapsed="true"] NavigationButton:hover:checked {
    background: transparent;
}

NavigationButton:pressed,
#Sidebar NavigationButton:pressed {
    background: {{SIDEBAR_PRESSED}};
}

NavigationButton:checked,
#Sidebar NavigationButton:checked {
    background: {{SIDEBAR_ACTIVE}};
    border-left: 3px solid {{PRIMARY}};
    font-weight: 600;
    color: {{SIDEBAR_TEXT}};
}

/* Collapsed: same left accent, no fill plate — icon-only selection
   must not read heavier than expanded (label + soft fill). */
#Sidebar[collapsed="true"] NavigationButton {
    padding: 0 6px;
    text-align: center;
}

#Sidebar[collapsed="true"] NavigationButton:checked {
    background: transparent;
    border-left: 3px solid {{PRIMARY}};
    font-weight: 600;
}

NavigationButton:disabled,
#Sidebar NavigationButton:disabled {
    color: {{SIDEBAR_MUTED}};
    background: transparent;
}

NavigationButton:focus,
#Sidebar NavigationButton:focus {
    outline: none;
}

NavigationButton:focus:!checked,
#Sidebar NavigationButton:focus:!checked {
    background: {{SIDEBAR_HOVER}};
    border-left: 3px solid {{SIDEBAR_MUTED}};
}

QLabel#LoginBrand {
    font-size: 22px;
    font-weight: 800;
    color: {{TEXT}};
}

QDialog#UnlockDialog {
    background: {{BACKGROUND}};
}

QLineEdit#EnterpriseSearch {
    min-height: 36px;
    padding-left: 8px;
    border-radius: 8px;
    background: {{SURFACE}};
}

QTableView#EnterpriseTable,
QTableWidget#EnterpriseTable {
    background: {{SURFACE}};
    alternate-background-color: {{TABLE_ALTERNATE}};
    gridline-color: transparent;
    border: 1px solid {{BORDER}};
    border-radius: {{CARD_RADIUS}};
    selection-background-color: {{SELECTED}};
    selection-color: {{TEXT}};
    outline: none;
}

QTableView#EnterpriseTable::item,
QTableWidget#EnterpriseTable::item {
    padding: 8px 12px;
    border: none;
    min-height: 40px;
}

QTableView#EnterpriseTable::item:hover,
QTableWidget#EnterpriseTable::item:hover {
    background: {{HOVER}};
}

QTableView#EnterpriseTable::item:selected,
QTableWidget#EnterpriseTable::item:selected {
    background: {{SELECTED}};
    color: {{TEXT}};
}

QTableView#EnterpriseTable::item:selected:hover,
QTableWidget#EnterpriseTable::item:selected:hover {
    background: {{SELECTED}};
}

QTableView#EnterpriseTable QHeaderView::section,
QTableWidget#EnterpriseTable QHeaderView::section {
    background: {{TABLE_HEADER}};
    color: {{TEXT_MUTED}};
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid {{BORDER}};
    font-weight: 600;
    font-size: 11px;
}

QFrame#EmptyStateCard {
    background: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: {{CARD_RADIUS}};
}

QLabel#EmptyStateTitle {
    font-size: 20px;
    font-weight: 700;
    color: {{TEXT}};
}

QLabel#EmptyStateSubtitle {
    font-size: 13px;
    color: {{SECONDARY}};
}

QLabel#CustomerStatusLabel {
    font-size: 12px;
    color: {{SECONDARY}};
}

QLabel#DialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: {{TEXT}};
}

QComboBox#EnterpriseFilter,
QDateEdit#EnterpriseFilter {
    min-height: 36px;
    min-width: 140px;
    padding: 4px 10px;
    border-radius: 8px;
    background: {{SURFACE}};
}

QComboBox#EnterpriseFilterCompact,
QDateEdit#EnterpriseFilterCompact {
    min-height: 36px;
    min-width: 96px;
    padding: 4px 8px;
    border-radius: 8px;
    background: {{SURFACE}};
}

QMenu#ToolbarOverflowMenu {
    min-width: 160px;
}

QPushButton#PeriodChip {
    min-height: 36px;
    padding: 6px 14px;
    border-radius: 8px;
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
}

QPushButton#PeriodChip:hover {
    background: {{TABLE_HEADER}};
}

QPushButton#PeriodChip:checked {
    background: {{PRIMARY}};
    color: {{ON_PRIMARY}};
    border: 1px solid {{PRIMARY}};
}

QDialog#CustomerDialog,
QDialog#InvoiceDialog,
QDialog#InvoiceItemDialog,
QDialog#OfferDialog,
QDialog#ArticleDialog,
QDialog#OrderDialog,
QDialog#PaymentDialog,
QDialog#MovementDialog,
QDialog#InventoryDialog,
QDialog#SupplierDialog,
QDialog#PurchaseDialog,
QDialog#ReceiveDialog,
QDialog#UploadDialog,
QDialog#CrmDialog {
    background: {{BACKGROUND}};
}

QLabel#DetailValue {
    color: {{TEXT}};
    font-weight: 500;
}

#SettingsScroll,
#SettingsCanvas {
    background: {{BACKGROUND}};
    border: none;
}

QLabel#SettingsPreview {
    font-size: 16px;
    font-weight: 700;
    color: {{PRIMARY}};
}

QLabel#LogoPreview {
    min-width: 90px;
    max-width: 90px;
    min-height: 90px;
    max-height: 90px;
    color: {{SECONDARY}};
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    min-height: 24px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QPushButton#AccentChip {
    min-height: 36px;
    min-width: 88px;
    padding: 6px 14px;
    border-radius: {{CONTROL_RADIUS}};
    background: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
}

QPushButton#AccentChip:checked {
    background: {{PRIMARY}};
    color: {{ON_PRIMARY}};
    border: 1px solid {{PRIMARY}};
}

QDialog#ExcelWizard {
    background: {{BACKGROUND}};
}

QTabWidget#CrmTabs::pane {
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    background: {{BACKGROUND}};
}

#CrmPipelineScroll {
    background: {{BACKGROUND}};
    border: none;
}

#ReportsSplitter {
    background: {{BACKGROUND}};
}

#DialogFooter {
    min-height: 48px;
    max-height: 48px;
    background: {{SURFACE}};
    border-top: 1px solid {{BORDER}};
}

QScrollArea#DialogScroll {
    border: none;
    background: {{BACKGROUND}};
}

#DialogHeader {
    background: {{BACKGROUND}};
}

#ToastBanner {
    background: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
    min-height: 44px;
}

#ToastBanner[kind="success"] {
    border-left: 4px solid {{SUCCESS}};
}

#ToastBanner[kind="info"] {
    border-left: 4px solid {{PRIMARY}};
}

QLabel#ToastLabel {
    font-size: 13px;
    color: {{TEXT}};
}

QLabel#StatusChip {
    font-size: 12px;
    color: {{SECONDARY}};
    padding: 0 8px;
}
