# Server-only secrets. Never put these values in the desktop application.
JUTAN_LICENSE_SIGNING_KEY=generated-private-key
JUTAN_LICENSE_PEPPER=generated-random-pepper
JUTAN_LICENSE_ADMIN_TOKEN=generated-admin-token
JUTAN_LICENSE_DB=license_server/data/licenses.db

# Desktop build configuration. Only the public key belongs in the client.
JU_TAN_LICENSE_REQUIRED=1
JU_TAN_LICENSE_SERVER_URL=https://license.ju-tan.com
JU_TAN_LICENSE_PUBLIC_KEY=generated-public-key
